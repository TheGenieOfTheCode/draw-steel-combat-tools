  "relationships": {
    "systems": [{ "id": "draw-steel", "type": "system", "compatibility": {} }],
    "requires": [
      { "id": "socketlib", "type": "module", "compatibility": { "minimum": "1.1.3" } },
      { "id": "color-picker", "type": "module", "compatibility": { "minimum": "1.7" } },
      { "id": "lib-wrapper", "type": "module", "compatibility": { "minimum": "1.12.0" } },
      { "id": "draw-steel-target-damage", "type": "module", "compatibility": { "minimum": "1.0.8" } },
      { "id": "draw-steel-ctlib", "type": "module", "manifest": "https://github.com/TheGenieOfTheCode/draw-steel-ctlib/releases/latest/download/module.json", "compatibility": { "minimum": "1.1.0" } }
    ],
    "recommends": [
      { "id": "draw-steel-death-tracker", "type": "module", "manifest": "https://github.com/TheGenieOfTheCode/draw-steel-death-tracker/releases/latest/download/module.json", "reason": "[Combat Tools] Keeps track of who falls: deaths announced in chat with an undo, the right minions taken from a squad, and the fallen left where they fell." },
      { "id": "draw-steel-battle-log", "type": "module", "manifest": "https://github.com/TheGenieOfTheCode/draw-steel-battle-log/releases/latest/download/module.json", "reason": "[Combat Tools] Draws each turn, round and fight into the chat log and folds away what's finished, and makes the chat cards match the dark theme." }
    ],
