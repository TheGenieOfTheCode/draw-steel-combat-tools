<div class="dsct-choose">

  {{#if ctx.hasDuplicates}}
  <p class="dsct-choose-warning">
    <i class="fa-solid fa-triangle-exclamation"></i>
    {{localize "DSCT.choose.duplicateWarning" names=ctx.duplicateNames}}
  </p>
  {{/if}}

  {{#if ctx.choices.length}}
  <p class="dsct-choose-count">
    {{localize "DSCT.choose.count.before"}}
    <select name="choose.count">{{selectOptions ctx.countOptions selected=ctx.count valueAttr="value" labelAttr="label"}}</select>
    {{localize "DSCT.choose.count.after"}}
  </p>
  {{/if}}

  {{#each ctx.choices as |choice|}}
  <details class="dsct-choice" data-index="{{choice.index}}" {{#if choice.open}}open{{/if}}>
    <summary class="dsct-choice-summary">
      <i class="fa-solid fa-chevron-right dsct-choice-caret"></i>
      <button type="button" class="dsct-choice-icon" data-action="dsctPickIcon" data-index="{{choice.index}}"
              data-fallback="{{choice.iconPreview}}" data-tooltip="DSCT.choose.icon.hint">
        <img src="{{choice.iconPreview}}" alt="">
      </button>
      <span class="dsct-choice-title">{{#if choice.src.name}}{{choice.src.name}}{{else}}{{localize "DSCT.choose.unnamed" n=choice.number}}{{/if}}</span>
      <a class="dsct-choice-remove" data-action="dsctRemoveChoice" data-index="{{choice.index}}"
         data-tooltip="DSCT.choose.remove"><i class="fa-solid fa-trash"></i></a>
    </summary>

    <div class="dsct-choice-body">
    <input type="hidden" name="{{concat choice.prefix '.icon'}}" value="{{choice.src.icon}}">

    {{formGroup ../ctx.fields.name value=choice.src.name name=(concat choice.prefix ".name") label="DSCT.choose.name.label" localize=true}}
    {{formGroup ../ctx.fields.preview value=choice.src.preview name=(concat choice.prefix ".preview") placeholder=choice.ghostPreview label="DSCT.choose.preview.label" hint="DSCT.choose.preview.hint" localize=true}}
    {{formGroup ../ctx.fields.story value=choice.src.story name=(concat choice.prefix ".story") placeholder=choice.ghostStory label=../ctx.labels.story}}
    {{formGroup ../ctx.fields.keywords value=choice.src.keywords name=(concat choice.prefix ".keywords") options=../ctx.keywordOptions label=../ctx.labels.keywords}}

    <fieldset>
      <legend>{{../ctx.labels.distanceLegend}}</legend>
      {{formGroup ../ctx.fields.distance.fields.type value=choice.src.distance.type name=(concat choice.prefix ".distance.type") options=../ctx.distanceTypes label=../ctx.labels.distanceType}}
      {{#if choice.primaryDistance}}
      {{formGroup ../ctx.fields.distance.fields.primary value=choice.src.distance.primary name=(concat choice.prefix ".distance.primary") placeholder=choice.ghostPrimary label=choice.primaryDistance}}
      {{/if}}
      {{#if choice.secondaryDistance}}
      {{formGroup ../ctx.fields.distance.fields.secondary value=choice.src.distance.secondary name=(concat choice.prefix ".distance.secondary") placeholder=choice.ghostSecondary label=choice.secondaryDistance}}
      {{/if}}
      {{#if choice.tertiaryDistance}}
      {{formGroup ../ctx.fields.distance.fields.tertiary value=choice.src.distance.tertiary name=(concat choice.prefix ".distance.tertiary") placeholder=choice.ghostTertiary label=choice.tertiaryDistance}}
      {{/if}}
    </fieldset>

    <fieldset>
      <legend>{{../ctx.labels.targetLegend}}</legend>
      {{formGroup ../ctx.fields.target.fields.type value=choice.src.target.type name=(concat choice.prefix ".target.type") options=../ctx.targetTypes label=../ctx.labels.targetType}}
      {{formGroup ../ctx.fields.target.fields.custom value=choice.src.target.custom name=(concat choice.prefix ".target.custom") label=../ctx.labels.targetCustom}}
      {{#if choice.showTargetValue}}
      {{formGroup ../ctx.fields.target.fields.value value=choice.src.target.value name=(concat choice.prefix ".target.value") label=../ctx.labels.targetValue}}
      {{/if}}
    </fieldset>

    {{#if ../ctx.hasEffects}}
    {{formGroup ../ctx.fields.effects value=choice.src.effects name=(concat choice.prefix ".effects") options=../ctx.effectOptions label="DSCT.choose.effects.label" hint="DSCT.choose.effects.hint" localize=true}}
    {{else}}
    <p class="dsct-choose-empty">{{localize "DSCT.choose.noEffects"}}</p>
    {{/if}}
    </div>
  </details>
  {{/each}}

  {{#unless ctx.choices.length}}
  <p class="dsct-choose-empty">{{localize "DSCT.choose.noChoices"}}</p>
  {{/unless}}

  <button type="button" class="dsct-choose-add" data-action="dsctAddChoice">
    <i class="fa-solid fa-plus"></i> {{localize "DSCT.choose.add"}}
  </button>
</div>
